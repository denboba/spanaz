rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwnerAdmin() {
      return
        request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'homespanaz@gmail.com';
    }

    function isBookingCustomer(data) {
      return
        request.auth != null &&
        ('customerUid' in data) &&
        data.customerUid == request.auth.uid;
    }

    function validCustomerIdentity(data) {
      return
        (
          !('customerUid' in data) &&
          !('customerEmail' in data)
        ) ||
        (
          request.auth != null &&
          data.customerUid == request.auth.uid &&
          data.customerEmail == request.auth.token.email
        );
    }

    function validService(data) {
      return
        (data.serviceKey == 'relaxare' && data.serviceName in [
          'Masaj de relaxare',
          'Relaxation massage',
          'Experiența de Relaxare',
          'The Relaxation Experience'
        ]) ||
        (data.serviceKey == 'deepTissue' && data.serviceName in ['Masaj deep tissue', 'Deep tissue massage']) ||
        (data.serviceKey == 'spateGat' && data.serviceName in ['Drenaj limfatic', 'Lymphatic drainage']) ||
        (data.serviceKey == 'aromaterapie' && data.serviceName in ['Masaj cu aromaterapie', 'Aromatherapy massage']) ||
        (data.serviceKey == 'anticelulitic' && data.serviceName in ['Masaj anticelulitic', 'Anti-cellulite massage']) ||
        (data.serviceKey == 'sheaAfrican' && data.serviceName in ['Masaj african cu unt de shea', 'African massage with shea butter']) ||
        (data.serviceKey == 'bamboo' && data.serviceName in ['Masaj cu bețe de bambus', 'Bamboo stick massage']) ||
        (data.serviceKey == 'foot' && data.serviceName in ['Masaj pentru picioare', 'Foot massage']) ||
        (data.serviceKey == 'facial' && data.serviceName in ['Masaj facial', 'Facial massage']);
    }

    function validSession(data) {
      return
        (data.sessionKey == 'relax' && data.sessionName == 'Relax' && data.durationMinutes == 60 && data.priceLei == 200) ||
        (data.sessionKey == 'restore' && data.sessionName == 'Restore' && data.durationMinutes == 90 && data.priceLei == 270) ||
        (data.sessionKey == 'signature' && data.sessionName == 'Signature' && data.durationMinutes == 120 && data.priceLei == 340);
    }

    function validAdminManagedFields(data) {
      return
        data.status in ['pending', 'confirmed', 'completed', 'cancelled'] &&
        (!('confirmedDate' in data) || (data.confirmedDate is string && data.confirmedDate.size() <= 10)) &&
        (!('confirmedTime' in data) || (data.confirmedTime is string && data.confirmedTime.size() <= 5)) &&
        (!('internalNote' in data) || (data.internalNote is string && data.internalNote.size() <= 1500)) &&
        data.updatedAt is timestamp &&
        data.updatedBy == request.auth.token.email;
    }

    function validCustomerCancellation() {
      return
        isBookingCustomer(resource.data) &&
        resource.data.status in ['pending', 'confirmed'] &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'updatedBy'
        ]) &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.updatedBy == request.auth.token.email;
    }

    match /bookings/{bookingId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'reference',
          'name',
          'phone',
          'whatsapp',
          'serviceKey',
          'serviceName',
          'sessionKey',
          'sessionName',
          'durationMinutes',
          'priceLei',
          'appointmentDate',
          'appointmentTime',
          'sector',
          'address',
          'people',
          'message',
          'language',
          'status',
          'source',
          'createdAt',
          'customerUid',
          'customerEmail',
          'privacyNoticeVersion',
          'privacyAcknowledgedAt',
          'termsVersion',
          'termsAcceptedAt'
        ]) &&
        validCustomerIdentity(request.resource.data) &&
        request.resource.data.reference is string &&
        request.resource.data.reference.matches('^SN-[0-9]{6}-[A-Z0-9]{4}$') &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.matches('^\\+[1-9][0-9]{7,14}$') &&
        request.resource.data.whatsapp == request.resource.data.phone &&
        validService(request.resource.data) &&
        validSession(request.resource.data) &&
        request.resource.data.appointmentDate is string &&
        request.resource.data.appointmentDate.size() == 10 &&
        request.resource.data.appointmentTime is string &&
        request.resource.data.appointmentTime.size() == 5 &&
        request.resource.data.sector in ['Sector 1', 'Sector 4', 'Sector 6'] &&
        request.resource.data.address is string &&
        request.resource.data.address.size() >= 4 &&
        request.resource.data.address.size() <= 300 &&
        request.resource.data.people is int &&
        request.resource.data.people >= 1 &&
        request.resource.data.people <= 4 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 1000 &&
        request.resource.data.language in ['ro', 'en'] &&
        request.resource.data.status == 'pending' &&
        request.resource.data.source == 'website' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.privacyNoticeVersion == '2026-09-19' &&
        request.resource.data.privacyAcknowledgedAt is timestamp &&
        request.resource.data.termsVersion == '2026-09-19' &&
        request.resource.data.termsAcceptedAt is timestamp;

      allow read: if isOwnerAdmin() || isBookingCustomer(resource.data);

      allow update: if
        (
          isOwnerAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'confirmedDate',
            'confirmedTime',
            'internalNote',
            'updatedAt',
            'updatedBy'
          ]) &&
          validAdminManagedFields(request.resource.data)
        ) ||
        validCustomerCancellation();

      allow delete: if false;
    }

    // Public availability intentionally contains no customer identity or
    // contact data. Visitors can read confirmed occupied slots only.
    match /availability/{date}/slots/{slotId} {
      allow read: if true;

      allow create, update: if
        isOwnerAdmin() &&
        request.resource.data.keys().hasOnly([
          'startTime',
          'durationMinutes',
          'status',
          'updatedAt'
        ]) &&
        request.resource.data.startTime is string &&
        request.resource.data.startTime.size() == 5 &&
        request.resource.data.durationMinutes in [60, 90, 120] &&
        request.resource.data.status == 'booked' &&
        request.resource.data.updatedAt is timestamp;

      allow delete: if
        isOwnerAdmin() ||
        (
          request.auth != null &&
          getAfter(/databases/$(database)/documents/bookings/$(slotId)).data.customerUid == request.auth.uid &&
          getAfter(/databases/$(database)/documents/bookings/$(slotId)).data.status == 'cancelled'
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
